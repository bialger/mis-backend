# On the server: /opt/mis/.env. MIS_IMAGE, APP_PORT, and DOMAIN_NAME are required for HTTPS deployment.
MIS_IMAGE=ghcr.io/your-org/your-repo:latest
APP_PORT=8000
DOMAIN_NAME=mis.your-domain.com
POSTGRES_USER=mis
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=mis

# Yandex Object Storage (S3). Create a static access key for a service account with storage.uploader role.
YC_KEY=your_static_key_id_here
YC_SECRET=your_static_secret_here
YC_BUCKET=your-bucket-name

# JWT / Auth
# Use a long random secret (>= 32 chars).
JWT_SECRET=replace_with_long_random_secret
# true in production behind HTTPS, false for plain HTTP local deployments.
JWT_COOKIE_SECURE=true
# Access token TTL in seconds (default 8h).
JWT_ACCESS_TOKEN_EXPIRATION=28800

# CORS allowlist (comma-separated, no wildcard when credentials are enabled)
APP_CORS_ALLOWED_ORIGINS=https://mis.your-domain.com,http://localhost:3000,http://localhost:5173

# For local development (without Docker), set if different from defaults:
# MICRONAUT_DATASOURCES_DEFAULT_URL=jdbc:postgresql://localhost:5432/mis
# MICRONAUT_DATASOURCES_DEFAULT_USERNAME=mis
# MICRONAUT_DATASOURCES_DEFAULT_PASSWORD=mis
